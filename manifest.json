// CJ Online Shopping - Cloudflare Worker (Backend API)
// Works with the EXISTING D1 tables (products, orders). Run migrate.sql once to add new columns/tables.

const enc = new TextEncoder();
const STATUSES = ['Pending', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'];

// ---------- helpers ----------
function cors(env) {
  return {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,PUT,DELETE,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  };
}
function json(data, env, status = 200) {
  return new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json; charset=utf-8', ...cors(env) } });
}
const err = (msg, env, status = 400) => json({ error: msg }, env, status);

function b64url(bytes) {
  let s = '';
  new Uint8Array(bytes).forEach((b) => (s += String.fromCharCode(b)));
  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
function b64urlDecode(str) {
  str = str.replace(/-/g, '+').replace(/_/g, '/');
  while (str.length % 4) str += '=';
  return atob(str);
}
async function hmac(secret, data) {
  const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  return b64url(await crypto.subtle.sign('HMAC', key, enc.encode(data)));
}
async function makeToken(env) {
  const payload = b64url(enc.encode(JSON.stringify({ exp: Date.now() + 12 * 3600 * 1000 })));
  return `${payload}.${await hmac(env.ADMIN_PASSWORD, payload)}`;
}
async function isAdmin(request, env) {
  if (!env.ADMIN_PASSWORD) return false;
  const token = (request.headers.get('Authorization') || '').replace('Bearer ', '');
  const [payload, sig] = token.split('.');
  if (!payload || !sig) return false;
  if ((await hmac(env.ADMIN_PASSWORD, payload)) !== sig) return false;
  try { return JSON.parse(b64urlDecode(payload)).exp > Date.now(); } catch { return false; }
}
function timingSafeEqual(a, b) {
  if (a.length !== b.length) return false;
  let r = 0;
  for (let i = 0; i < a.length; i++) r |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return r === 0;
}
async function body(request) { try { return await request.json(); } catch { return {}; } }
const clean = (s, max = 500) => String(s ?? '').trim().slice(0, max);
const num = (n, d = 0) => (Number.isFinite(Number(n)) ? Number(n) : d);
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const list = (s) => String(s || '').split(',').map((x) => x.trim()).filter(Boolean);
const digits = (s) => String(s).replace(/\D/g, '');

// ---------- customer accounts ----------
const userKey = (env) => (env.JWT_SECRET || env.ADMIN_PASSWORD || '') + ':user';
function fromB64url(str) {
  const bin = b64urlDecode(str);
  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
}
async function pbkdf2(password, salt, iter) {
  const key = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, ['deriveBits']);
  const bits = await crypto.subtle.deriveBits({ name: 'PBKDF2', salt, iterations: iter, hash: 'SHA-256' }, key, 256);
  return b64url(bits);
}
// stored as "<iterations>$<hash>". Default 30000 keeps Workers FREE plan CPU limit safe.
// Paid plan: set variable PBKDF2_ITER = 100000 (max allowed by Workers) for stronger hashes.
async function hashPassword(env, password, salt) {
  const iter = Math.min(100000, Math.max(1000, Math.round(num(env.PBKDF2_ITER, 10000))));
  return `${iter}$${await pbkdf2(password, salt, iter)}`;
}
async function verifyPassword(password, saltB64, stored) {
  const [iterStr, hash] = String(stored).split('$');
  const iter = Math.min(100000, Math.max(1000, parseInt(iterStr, 10) || 0));
  if (!hash) return false;
  return timingSafeEqual(await pbkdf2(password, fromB64url(saltB64), iter), hash);
}
async function makeUserToken(env, uid) {
  const payload = b64url(enc.encode(JSON.stringify({ uid, exp: Date.now() + 30 * 24 * 3600 * 1000 })));
  return `${payload}.${await hmac(userKey(env), payload)}`;
}
async function getUser(request, env) {
  if (!env.JWT_SECRET && !env.ADMIN_PASSWORD) return null;
  const token = (request.headers.get('Authorization') || '').replace('Bearer ', '');
  const [payload, sig] = token.split('.');
  if (!payload || !sig) return null;
  if ((await hmac(userKey(env), payload)) !== sig) return null;
  let data;
  try { data = JSON.parse(b64urlDecode(payload)); } catch { return null; }
  if (!data.uid || !(data.exp > Date.now())) return null;
  return env.DB.prepare('SELECT id, name, email, phone, address, created_at FROM users WHERE id = ?').bind(data.uid).first();
}
const publicUser = (u) => ({ id: u.id, name: u.name, email: u.email, phone: u.phone || '', address: u.address || '' });

async function telegram(env, text) {
  if (!env.TELEGRAM_BOT_TOKEN || !env.TELEGRAM_CHAT_ID) return;
  try {
    await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: env.TELEGRAM_CHAT_ID, text, parse_mode: 'HTML' }),
    });
  } catch { /* ignore */ }
}

// DB row -> API product. DB: price = original price, sale = discounted price (optional)
function mapProduct(p, admin = false) {
  const price = Number(p.price) || 0;
  const sale = p.sale != null && Number(p.sale) > 0 && Number(p.sale) < price ? Number(p.sale) : null;
  const imgs = String(p.image || '').split('|').map((s) => s.trim());
  return {
    id: p.id,
    name_en: p.name,
    name_am: p.name_am || '',
    desc_en: p.description || '',
    desc_am: p.desc_am || '',
    category: p.category || 'General',
    price: sale ?? price,
    old_price: sale ? price : 0,
    stock: Number(p.stock) || 0,
    sizes: admin ? p.sizes || '' : list(p.sizes),
    colors: admin ? p.colors || '' : list(p.colors),
    image_front: imgs[0] || '',
    image_side: imgs[1] || '',
    image_top: imgs[2] || '',
    video: p.video || '',
    featured: p.featured ? 1 : 0,
    active: p.active === 0 ? 0 : 1,
    created_at: p.created_at,
  };
}

async function getCoupon(env, code) {
  const c = clean(code, 40).toUpperCase();
  if (!c) return null;
  return env.DB.prepare('SELECT * FROM coupons WHERE code = ? AND active = 1').bind(c).first();
}
function shippingFor(env, subtotal) {
  const min = num(env.FREE_SHIPPING_MIN, 3000);
  const fee = num(env.SHIPPING_FEE, 100);
  return subtotal >= min ? 0 : fee;
}
function parseItems(v) { try { return JSON.parse(v || '[]'); } catch { return []; } }

const ACTIVE = 'COALESCE(active,1) = 1';

// ---------- main ----------
export default {
  async fetch(request, env) {
    if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors(env) });

    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, '');
    const method = request.method;

    try {
      if (!env.DB) return err('D1 binding "DB" is missing.', env, 500);

      // ===== PUBLIC =====
      if (path === '/api/health') return json({ ok: true, version: 'v3.1-cj-shop', service: 'CJ Shopping API', database: 'connected' }, env);

      if (path === '/api/config') {
        return json({ free_shipping_min: num(env.FREE_SHIPPING_MIN, 3000), shipping_fee: num(env.SHIPPING_FEE, 100) }, env);
      }

      if (path.startsWith('/api/img/') && method === 'GET') {
        if (!env.IMAGES) return err('Not found', env, 404);
        const obj = await env.IMAGES.get(decodeURIComponent(path.slice('/api/img/'.length)));
        if (!obj) return err('Not found', env, 404);
        return new Response(obj.body, { headers: { 'Content-Type': obj.httpMetadata?.contentType || 'image/jpeg', 'Cache-Control': 'public, max-age=31536000', ...cors(env) } });
      }

      if (path === '/api/products' && method === 'GET') {
        const q = clean(url.searchParams.get('q'), 80);
        const cat = clean(url.searchParams.get('category'), 60);
        let sql = `SELECT * FROM products WHERE ${ACTIVE}`;
        const args = [];
        if (q) { sql += ' AND (name LIKE ? OR name_am LIKE ? OR category LIKE ?)'; args.push(`%${q}%`, `%${q}%`, `%${q}%`); }
        if (cat) { sql += ' AND category = ?'; args.push(cat); }
        sql += ' ORDER BY created_at DESC';
        const { results } = await env.DB.prepare(sql).bind(...args).all();
        return json((results || []).map((p) => mapProduct(p)), env);
      }

      let m = path.match(/^\/api\/products\/([^/]+)$/);
      if (m && method === 'GET') {
        const id = decodeURIComponent(m[1]);
        const p = await env.DB.prepare(`SELECT * FROM products WHERE id = ? AND ${ACTIVE}`).bind(id).first();
        if (!p) return err('Product not found', env, 404);
        const { results } = await env.DB.prepare('SELECT id, name, rating, comment, created_at FROM reviews WHERE product_id = ? ORDER BY id DESC LIMIT 50').bind(id).all();
        return json({ ...mapProduct(p), reviews: results || [] }, env);
      }

      if (path === '/api/categories' && method === 'GET') {
        const { results } = await env.DB.prepare(`SELECT category, COUNT(*) as count FROM products WHERE ${ACTIVE} GROUP BY category ORDER BY category`).all();
        return json(results || [], env);
      }

      if (path === '/api/coupons/validate' && method === 'POST') {
        const b = await body(request);
        const c = await getCoupon(env, b.code);
        if (!c) return err('Invalid coupon', env, 404);
        return json({ code: c.code, percent: c.percent }, env);
      }

      if (path === '/api/reviews' && method === 'POST') {
        const b = await body(request);
        const name = clean(b.name, 60);
        const pid = clean(b.product_id, 80);
        const rating = Math.min(5, Math.max(1, Math.round(num(b.rating, 5))));
        if (!name || !pid) return err('Name and product required', env);
        const exists = await env.DB.prepare('SELECT id FROM products WHERE id = ?').bind(pid).first();
        if (!exists) return err('Product not found', env, 404);
        await env.DB.prepare('INSERT INTO reviews (product_id, name, rating, comment) VALUES (?,?,?,?)').bind(pid, name, rating, clean(b.comment, 600)).run();
        return json({ ok: true }, env);
      }

      // ----- customer accounts -----
      if (path === '/api/auth/register' && method === 'POST') {
        const b = await body(request);
        const name = clean(b.name, 80);
        const email = clean(b.email, 120).toLowerCase();
        const phone = clean(b.phone, 30);
        const password = String(b.password || '');
        if (!name) return err('Name is required', env);
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return err('Valid email is required', env);
        if (phone && !/^[0-9+\-\s()]{7,20}$/.test(phone)) return err('Invalid phone number', env);
        if (password.length < 8 || password.length > 100) return err('Password must be at least 8 characters', env);
        if (await env.DB.prepare('SELECT id FROM users WHERE email = ?').bind(email).first()) return err('This email is already registered. Please login.', env, 409);
        const salt = crypto.getRandomValues(new Uint8Array(16));
        const hash = await hashPassword(env, password, salt);
        const id = crypto.randomUUID();
        await env.DB.prepare('INSERT INTO users (id,name,email,phone,address,pass_hash,salt,created_at) VALUES (?,?,?,?,?,?,?,?)')
          .bind(id, name, email, phone, '', hash, b64url(salt), new Date().toISOString()).run();
        return json({ token: await makeUserToken(env, id), user: { id, name, email, phone, address: '' } }, env, 201);
      }

      if (path === '/api/auth/login' && method === 'POST') {
        const b = await body(request);
        const email = clean(b.email, 120).toLowerCase();
        const u = await env.DB.prepare('SELECT * FROM users WHERE email = ?').bind(email).first();
        const bad = () => err('Incorrect email or password', env, 401);
        if (!u) return bad();
        if (!(await verifyPassword(String(b.password || ''), u.salt, u.pass_hash))) return bad();
        return json({ token: await makeUserToken(env, u.id), user: publicUser(u) }, env);
      }

      if (path === '/api/auth/me' && method === 'GET') {
        const u = await getUser(request, env);
        if (!u) return err('Please login', env, 401);
        return json({ user: publicUser(u) }, env);
      }

      if (path === '/api/auth/me' && method === 'PUT') {
        const u = await getUser(request, env);
        if (!u) return err('Please login', env, 401);
        const b = await body(request);
        const name = clean(b.name, 80) || u.name;
        const phone = clean(b.phone, 30);
        if (phone && !/^[0-9+\-\s()]{7,20}$/.test(phone)) return err('Invalid phone number', env);
        await env.DB.prepare('UPDATE users SET name = ?, phone = ?, address = ? WHERE id = ?').bind(name, phone, clean(b.address, 300), u.id).run();
        return json({ user: { id: u.id, name, email: u.email, phone, address: clean(b.address, 300) } }, env);
      }

      if (path === '/api/auth/password' && method === 'POST') {
        const u = await getUser(request, env);
        if (!u) return err('Please login', env, 401);
        const b = await body(request);
        const full = await env.DB.prepare('SELECT pass_hash, salt FROM users WHERE id = ?').bind(u.id).first();
        if (!(await verifyPassword(String(b.old_password || ''), full.salt, full.pass_hash))) return err('Current password is incorrect', env, 401);
        const np = String(b.new_password || '');
        if (np.length < 8 || np.length > 100) return err('New password must be at least 8 characters', env);
        const salt = crypto.getRandomValues(new Uint8Array(16));
        await env.DB.prepare('UPDATE users SET pass_hash = ?, salt = ? WHERE id = ?').bind(await hashPassword(env, np, salt), b64url(salt), u.id).run();
        return json({ ok: true }, env);
      }

      if (path === '/api/my/orders' && method === 'GET') {
        const u = await getUser(request, env);
        if (!u) return err('Please login', env, 401);
        const { results } = await env.DB.prepare('SELECT * FROM orders WHERE user_id = ? ORDER BY created_at DESC LIMIT 100').bind(u.id).all();
        return json((results || []).map((o) => ({ order_number: o.id, items: parseItems(o.items_json), subtotal: o.subtotal, discount: o.discount || 0, shipping: o.shipping || 0, total: o.total, status: o.status, created_at: o.created_at, phone: o.phone })), env);
      }

      // ----- create order -----
      if (path === '/api/orders' && method === 'POST') {
        const user = await getUser(request, env);
        if (!user) return err('Please login to place an order', env, 401);
        const b = await body(request);
        const name = clean(b.name, 100);
        const phone = clean(b.phone, 30);
        const address = clean(b.address, 500);
        const note = clean(b.note, 300);
        const items = Array.isArray(b.items) ? b.items.slice(0, 50) : [];
        if (!name || !phone || !address) return err('Name, phone and address are required', env);
        if (!/^[0-9+\-\s()]{7,20}$/.test(phone)) return err('Invalid phone number', env);
        if (!items.length) return err('Cart is empty', env);

        const checked = [];
        const qtyById = {};
        const stockById = {};
        let subtotal = 0;
        for (const it of items) {
          const qty = Math.round(num(it.qty, 0));
          if (qty < 1 || qty > 99) return err('Invalid quantity', env);
          const p = await env.DB.prepare(`SELECT * FROM products WHERE id = ? AND ${ACTIVE}`).bind(clean(it.id, 80)).first();
          if (!p) return err('A product in your cart is no longer available', env);
          qtyById[p.id] = (qtyById[p.id] || 0) + qty;
          stockById[p.id] = p.name;
          if (qtyById[p.id] > Number(p.stock)) return err(`Not enough stock for ${p.name} (available: ${p.stock})`, env);
          const mp = mapProduct(p);
          const size = clean(it.size, 20);
          const color = clean(it.color, 30);
          subtotal += mp.price * qty;
          checked.push({ id: p.id, name: p.name, name_am: p.name_am || '', qty, price: mp.price, size, color, variant: [size, color].filter(Boolean).join(' / '), image: mp.image_front });
        }

        let discount = 0;
        let couponCode = '';
        const coupon = await getCoupon(env, b.coupon);
        if (coupon) { discount = Math.round((subtotal * coupon.percent) / 100); couponCode = coupon.code; }
        const shipping = shippingFor(env, subtotal);
        const total = Math.max(0, subtotal - discount + shipping);

        let id = '';
        for (let i = 0; i < 6; i++) {
          id = 'CJ' + Math.floor(100000 + Math.random() * 900000);
          if (!(await env.DB.prepare('SELECT id FROM orders WHERE id = ?').bind(id).first())) break;
        }

        const stmts = [
          env.DB.prepare('INSERT INTO orders (id,name,phone,address,note,items_json,subtotal,discount,shipping,total,coupon_code,status,created_at,user_id) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)')
            .bind(id, name, phone, address, note, JSON.stringify(checked), subtotal, discount, shipping, total, couponCode, 'Pending', new Date().toISOString(), user.id),
        ];
        for (const [pid, q] of Object.entries(qtyById)) {
          stmts.push(env.DB.prepare('UPDATE products SET stock = stock - ? WHERE id = ? AND stock >= ?').bind(q, pid, q));
        }
        await env.DB.batch(stmts);

        const lines = checked.map((i) => `• ${esc(i.name)} x${i.qty}${i.variant ? ' [' + esc(i.variant) + ']' : ''} — ${i.price * i.qty} ETB`).join('\n');
        await telegram(env,
          `🛍️ <b>NEW CJ ORDER ${id}</b>\n\n👤 ${esc(name)}\n✉️ ${esc(user.email)}\n📞 ${esc(phone)}\n📍 ${esc(address)}\n${note ? '📝 ' + esc(note) + '\n' : ''}\n${lines}\n\nSubtotal: ${subtotal} ETB\n${couponCode ? `Coupon ${esc(couponCode)}: -${discount} ETB\n` : ''}Shipping: ${shipping} ETB\n💰 <b>TOTAL: ${total} ETB</b>`);

        return json({ order_number: id, subtotal, discount, shipping, total, status: 'Pending' }, env, 201);
      }

      if (path === '/api/orders/track' && method === 'GET') {
        const number = clean(url.searchParams.get('number'), 40).toUpperCase();
        const phone = clean(url.searchParams.get('phone'), 30);
        if (!number || !phone) return err('Order number and phone are required', env);
        const o = await env.DB.prepare('SELECT * FROM orders WHERE id = ?').bind(number).first();
        if (!o || digits(o.phone).slice(-8) !== digits(phone).slice(-8)) return err('Order not found', env, 404);
        return json({ order_number: o.id, items: parseItems(o.items_json), subtotal: o.subtotal, discount: o.discount, shipping: o.shipping || 0, total: o.total, coupon_code: o.coupon_code || '', status: o.status, created_at: o.created_at }, env);
      }

      // ===== ADMIN =====
      if (path === '/api/admin/login' && method === 'POST') {
        const b = await body(request);
        if (!env.ADMIN_PASSWORD) return err('ADMIN_PASSWORD secret is missing', env, 500);
        if (!timingSafeEqual(String(b.password || ''), env.ADMIN_PASSWORD)) return err('Incorrect password', env, 401);
        return json({ token: await makeToken(env) }, env);
      }

      if (path.startsWith('/api/admin/')) {
        if (!(await isAdmin(request, env))) return err('Unauthorized', env, 401);

        if (path === '/api/admin/stats' && method === 'GET') {
          const total = await env.DB.prepare("SELECT COUNT(*) c, COALESCE(SUM(total),0) s FROM orders WHERE status != 'Cancelled'").first();
          const today = await env.DB.prepare("SELECT COUNT(*) c, COALESCE(SUM(total),0) s FROM orders WHERE status != 'Cancelled' AND date(created_at) = date('now')").first();
          const pending = await env.DB.prepare("SELECT COUNT(*) c FROM orders WHERE status = 'Pending'").first();
          const products = await env.DB.prepare('SELECT COUNT(*) c FROM products').first();
          const low = await env.DB.prepare(`SELECT id, name AS name_en, stock FROM products WHERE stock <= 5 AND ${ACTIVE} ORDER BY stock LIMIT 10`).all();
          const byStatus = await env.DB.prepare('SELECT status, COUNT(*) c FROM orders GROUP BY status').all();
          const daily = await env.DB.prepare("SELECT date(created_at) d, COUNT(*) c, COALESCE(SUM(total),0) s FROM orders WHERE status != 'Cancelled' AND created_at >= datetime('now','-7 days') GROUP BY date(created_at) ORDER BY d").all();
          return json({ orders: total.c, revenue: total.s, today_orders: today.c, today_revenue: today.s, pending: pending.c, products: products.c, low_stock: low.results || [], by_status: byStatus.results || [], daily: daily.results || [] }, env);
        }

        if (path === '/api/admin/products' && method === 'GET') {
          const { results } = await env.DB.prepare('SELECT * FROM products ORDER BY created_at DESC').all();
          return json((results || []).map((p) => mapProduct(p, true)), env);
        }

        const saveProduct = async (b, id) => {
          const name = clean(b.name_en || b.name, 120);
          const category = clean(b.category, 80) || 'General';
          const sellPrice = num(b.price, -1);
          const oldPrice = num(b.old_price, 0);
          const stock = Math.round(num(b.stock, -1));
          if (!name || sellPrice < 0 || stock < 0) return err('Valid name, price and stock are required', env);
          let price = sellPrice, sale = null;
          if (oldPrice > sellPrice) { price = oldPrice; sale = sellPrice; }
          const image = [clean(b.image_front, 500), clean(b.image_side, 500), clean(b.image_top, 500)].join('|').replace(/\|+$/, '');
          const pid = id || crypto.randomUUID();
          await env.DB.prepare(`INSERT INTO products (id,name,name_am,category,price,sale,stock,image,video,description,desc_am,sizes,colors,featured,active,created_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            ON CONFLICT(id) DO UPDATE SET name=excluded.name,name_am=excluded.name_am,category=excluded.category,price=excluded.price,sale=excluded.sale,stock=excluded.stock,
            image=excluded.image,video=excluded.video,description=excluded.description,desc_am=excluded.desc_am,sizes=excluded.sizes,colors=excluded.colors,featured=excluded.featured,active=excluded.active`)
            .bind(pid, name, clean(b.name_am, 120), category, price, sale, stock, image, clean(b.video, 500), clean(b.desc_en ?? b.description, 2000), clean(b.desc_am, 2000), clean(b.sizes, 200), clean(b.colors, 200), b.featured ? 1 : 0, b.active === 0 || b.active === false ? 0 : 1, new Date().toISOString()).run();
          return json({ ok: true, success: true, id: pid }, env);
        };

        if (path === '/api/admin/products' && method === 'POST') {
          const b = await body(request);
          return saveProduct(b, b.id ? clean(b.id, 80) : '');
        }

        m = path.match(/^\/api\/admin\/products\/([^/]+)$/);
        if (m && method === 'PUT') return saveProduct(await body(request), decodeURIComponent(m[1]));
        if (m && method === 'DELETE') {
          const id = decodeURIComponent(m[1]);
          await env.DB.prepare('DELETE FROM products WHERE id = ?').bind(id).run();
          await env.DB.prepare('DELETE FROM reviews WHERE product_id = ?').bind(id).run();
          return json({ ok: true, success: true }, env);
        }

        if (path === '/api/admin/upload' && method === 'POST') {
          if (!env.IMAGES) return err('Image upload is not enabled (no R2 bucket). Paste an image URL instead.', env, 501);
          const file = (await request.formData()).get('file');
          if (!file || !file.type?.startsWith('image/')) return err('Image file required', env);
          if (file.size > 5 * 1024 * 1024) return err('Max 5MB', env);
          const ext = (file.type.split('/')[1] || 'jpg').replace(/[^a-z0-9]/gi, '');
          const key = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
          await env.IMAGES.put(key, file.stream(), { httpMetadata: { contentType: file.type } });
          const base = env.PUBLIC_API_URL || url.origin;
          return json({ url: `${base.replace(/\/$/, '')}/api/img/${key}` }, env);
        }

        if (path === '/api/admin/orders' && method === 'GET') {
          const status = clean(url.searchParams.get('status'), 20);
          const { results } = status
            ? await env.DB.prepare('SELECT * FROM orders WHERE status = ? ORDER BY created_at DESC LIMIT 300').bind(status).all()
            : await env.DB.prepare('SELECT * FROM orders ORDER BY created_at DESC LIMIT 300').all();
          return json((results || []).map((o) => ({
            id: o.id, order_number: o.id, customer_name: o.name, phone: o.phone, address: o.address, note: o.note || '',
            items: parseItems(o.items_json), subtotal: o.subtotal, discount: o.discount || 0, shipping: o.shipping || 0,
            total: o.total, coupon_code: o.coupon_code || '', status: o.status, created_at: o.created_at,
          })), env);
        }

        m = path.match(/^\/api\/admin\/orders\/([^/]+)\/status$/);
        if (m && (method === 'PUT' || method === 'POST')) {
          const b = await body(request);
          const id = decodeURIComponent(m[1]);
          if (!STATUSES.includes(b.status)) return err('Invalid status', env);
          const o = await env.DB.prepare('SELECT * FROM orders WHERE id = ?').bind(id).first();
          if (!o) return err('Order not found', env, 404);
          if (b.status === 'Cancelled' && o.status !== 'Cancelled') {
            for (const it of parseItems(o.items_json)) await env.DB.prepare('UPDATE products SET stock = stock + ? WHERE id = ?').bind(it.qty, it.id).run();
          } else if (o.status === 'Cancelled' && b.status !== 'Cancelled') {
            for (const it of parseItems(o.items_json)) await env.DB.prepare('UPDATE products SET stock = MAX(0, stock - ?) WHERE id = ?').bind(it.qty, it.id).run();
          }
          await env.DB.prepare('UPDATE orders SET status = ? WHERE id = ?').bind(b.status, id).run();
          await telegram(env, `📦 Order <b>${esc(o.id)}</b> → <b>${b.status}</b>`);
          return json({ ok: true, success: true }, env);
        }

        m = path.match(/^\/api\/admin\/orders\/([^/]+)$/);
        if (m && method === 'DELETE') {
          await env.DB.prepare('DELETE FROM orders WHERE id = ?').bind(decodeURIComponent(m[1])).run();
          return json({ ok: true }, env);
        }

        if (path === '/api/admin/coupons' && method === 'GET') {
          const { results } = await env.DB.prepare('SELECT * FROM coupons ORDER BY id DESC').all();
          return json(results || [], env);
        }
        if (path === '/api/admin/coupons' && method === 'POST') {
          const b = await body(request);
          const code = clean(b.code, 40).toUpperCase();
          const percent = num(b.percent);
          if (!code || percent <= 0 || percent > 100) return err('Code and percent (1-100) required', env);
          try { await env.DB.prepare('INSERT INTO coupons (code, percent) VALUES (?, ?)').bind(code, percent).run(); }
          catch { return err('Coupon already exists', env, 409); }
          return json({ ok: true }, env, 201);
        }
        m = path.match(/^\/api\/admin\/coupons\/(\d+)$/);
        if (m && method === 'PUT') {
          const b = await body(request);
          await env.DB.prepare('UPDATE coupons SET active = ? WHERE id = ?').bind(b.active ? 1 : 0, m[1]).run();
          return json({ ok: true }, env);
        }
        if (m && method === 'DELETE') {
          await env.DB.prepare('DELETE FROM coupons WHERE id = ?').bind(m[1]).run();
          return json({ ok: true }, env);
        }

        if (path === '/api/admin/reviews' && method === 'GET') {
          const { results } = await env.DB.prepare('SELECT r.*, p.name AS product FROM reviews r LEFT JOIN products p ON p.id = r.product_id ORDER BY r.id DESC LIMIT 200').all();
          return json(results || [], env);
        }
        m = path.match(/^\/api\/admin\/reviews\/(\d+)$/);
        if (m && method === 'DELETE') {
          await env.DB.prepare('DELETE FROM reviews WHERE id = ?').bind(m[1]).run();
          return json({ ok: true }, env);
        }

        if (path === '/api/admin/users' && method === 'GET') {
          const { results } = await env.DB.prepare('SELECT id, name, email, phone, created_at FROM users ORDER BY created_at DESC LIMIT 500').all();
          return json(results || [], env);
        }

        return err('Admin route not found', env, 404);
      }

      return err('Not found', env, 404);
    } catch (e) {
      return err('Server error: ' + (e && e.message ? e.message : e), env, 500);
    }
  },
};
